{
  "name": "gregslist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:start": "node scripts/supabase-local.mjs start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:reset": "node scripts/supabase-local.mjs db reset",
    "db:test": "node scripts/supabase-local.mjs test db",
    "env:local": "node scripts/local-env.mjs",
    "admin:local": "node scripts/bootstrap-local.mjs",
    "test:e2e": "playwright test",
    "test:admin-concurrency": "node scripts/test-admin-concurrency.mjs",
    "test:privacy-concurrency": "node scripts/test-privacy-concurrency.mjs",
    "format:check": "prettier --check src scripts tests mobile/App.tsx mobile/features mobile/lib mobile/ui.tsx mobile/app.config.ts mobile/tests playwright.config.ts",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "photos:cleanup": "node scripts/cleanup-photos.mjs",
    "db:migrate": "node scripts/supabase-local.mjs migration up",
    "lint": "oxlint src scripts tests mobile/App.tsx mobile/features mobile/lib mobile/ui.tsx mobile/app.config.ts next.config.ts playwright.config.ts",
    "test:migrations": "node scripts/test-migrations.mjs",
    "production:check": "node scripts/production-check.mjs",
    "production:configure": "node scripts/production-configure.mjs",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:test": "npm --prefix mobile test",
    "mobile:export": "npm --prefix mobile run export",
    "privacy:cleanup": "node scripts/privacy-cleanup.mjs"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "supabase": "2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
