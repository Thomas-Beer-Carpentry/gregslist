# Reference only. Empty values are intentional; this file cannot deploy an app.
# Copy to ignored .env.production.local only on a trusted operator machine, or
# configure each value in the hosting/CI secret store. Never commit filled values.
# gregslist.friend is a preference, not a registered or verified deployment.

# WEB HOST: these exact names are read by the deployed Next.js application.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Privileged server credential. NEVER prefix this with NEXT_PUBLIC_ or EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Independent random server secret, at least 32 characters, for privacy maintenance.
CRON_SECRET=

# TRUSTED OPERATOR / READ-ONLY PRODUCTION CI: production scripts accept these
# overrides so an existing local .env.local need not be changed. The web host
# does not read these aliases; use the exact WEB HOST names above there.
SUPABASE_PROJECT_REF=
GREGSLIST_PRODUCTION_SITE_URL=
GREGSLIST_PRODUCTION_SUPABASE_URL=
GREGSLIST_PRODUCTION_PUBLISHABLE_KEY=
GREGSLIST_PRODUCTION_SERVICE_ROLE_KEY=
# Supabase account management token, used only by operator tooling/production CI.
SUPABASE_ACCESS_TOKEN=

# AUTH CONFIGURATION OPERATOR ONLY: not needed in the browser or phone app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Gregslist

# MOBILE / EAS: public service values are bundled; no privileged key belongs here.
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Real, publisher-owned identifiers and Expo project; no defaults approved.
GREGSLIST_IOS_BUNDLE_ID=
GREGSLIST_ANDROID_PACKAGE=
EXPO_OWNER=
EAS_PROJECT_ID=
# Optional noninteractive EAS authentication. Keep only in the EAS/CI secret store.
EXPO_TOKEN=
