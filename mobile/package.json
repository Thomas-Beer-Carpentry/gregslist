{
  "name": "gregslist-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export": "npm run export:ios && npm run export:android",
    "check:dependencies": "expo install --check",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "57.0.29",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
